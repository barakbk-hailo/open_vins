Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.6
    Tree Height: 347
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 112; 112; 115
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 120
      Marker Scale: 1
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.01
      Name: Path VIO
      Pose Style: None
      Topic:
        Value: /ov_msckf/pathimu
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.03
      Name: Path GT
      Pose Style: None
      Topic:
        Value: /ov_msckf/pathgt
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Color: 252; 175; 62
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: MSCKF Points
      Size (Pixels): 8
      Style: Points
      Topic:
        Value: /ov_msckf/points_msckf
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: SLAM Points
      Size (Pixels): 8
      Style: Points
      Topic:
        Value: /ov_msckf/points_slam
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: true
  Enabled: true
  Global Options:
    Background Color: 44; 44; 44
    Default Light: true
    Fixed Frame: global
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.83
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 720
  Width: 1280
  X: 0
  Y: 0
